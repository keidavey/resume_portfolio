---
import { profile } from '../data/profile';
---

<section id="skills" class="container" aria-label="Skills and education">
	<div class="column">
		<h2>Skills</h2>
		<ul class="skills">
			{profile.skills.map((skill) => <li>{skill}</li>)}
		</ul>
	</div>
	<div class="column">
		<h2>Education</h2>
		{
			profile.education.map((item) => (
				<div class="school">
					<div class="qualification">{item.qualification}</div>
					<div class="meta">
						{item.school} · {item.year}
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	section {
		padding-block: 80px;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
	}

	.column {
		flex: 1 1 420px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	h2 {
		margin: 0;
		font: var(--text-heading-2);
	}

	.skills {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.skills li {
		padding: 6px 12px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
	}

	.school {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.qualification {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 20px;
		line-height: 26px;
	}
	.meta {
		color: var(--ink-muted);
	}
</style>
