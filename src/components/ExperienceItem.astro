---
import type { Job } from '../data/job';

export interface Props {
	job: Job;
	/** Short version for the home page: one line instead of the full list. */
	compact?: boolean;
}

const { job, compact = false } = Astro.props;
---

<article class:list={{ compact }}>
	<div class="meta">
		<div class="dates label">{job.start} — {job.end}</div>
		{!compact && job.location && <div class="location">{job.location}</div>}
	</div>
	<div class="body">
		<h3>{job.title} <span>· {job.company}</span></h3>
		{
			compact ? (
				job.highlights[0] && <p>{job.highlights[0]}</p>
			) : (
				<ul>
					{job.highlights.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			)
		}
	</div>
</article>

<style>
	article {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 40px;
		padding: 32px 0;
		border-top: 1px solid var(--border);
	}
	article:last-child {
		border-bottom: 1px solid var(--border);
	}
	article.compact {
		padding: 28px 0;
	}

	.meta {
		flex: 0 0 260px;
		padding-top: 6px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.dates {
		color: var(--ink-muted);
	}

	.location {
		font-size: 13px;
		color: var(--ink-muted);
	}

	.body {
		flex: 999 1 480px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	h3 {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 24px;
		line-height: 30px;
	}
	.compact h3 {
		font-size: 22px;
		line-height: 28px;
	}
	h3 span {
		color: var(--accent-text);
	}

	p {
		margin: 0;
		color: var(--ink-muted);
	}

	ul {
		margin: 0;
		padding-left: 18px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		color: var(--ink-muted);
		font-size: 16px;
		line-height: 26px;
	}
</style>
