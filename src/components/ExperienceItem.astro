---
import type { Job } from '../data/profile';

export interface Props {
	job: Job;
}

const { job } = Astro.props;
---

<article>
	<div class="dates label">{job.start} — {job.end}</div>
	<div class="body">
		<h3>{job.title} <span>· {job.company}</span></h3>
		<ul>
			{job.highlights.map((item) => <li>{item}</li>)}
		</ul>
	</div>
</article>

<style>
	article {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 40px;
		padding: 28px 0;
		border-top: 1px solid var(--border);
	}
	article:last-child {
		border-bottom: 1px solid var(--border);
	}

	.dates {
		flex: 0 0 200px;
		color: var(--ink-muted);
		padding-top: 6px;
	}

	.body {
		flex: 999 1 480px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	h3 {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 22px;
		line-height: 28px;
	}
	h3 span {
		color: var(--accent-text);
	}

	ul {
		margin: 0;
		padding-left: 18px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		color: var(--ink-muted);
	}
</style>
