---
import { formatPostDate, readingMinutes, type Post } from '../utils/blog';

export interface Props {
	post: Post;
	/** Short version for the home page: no reading time. */
	compact?: boolean;
}

const { post, compact = false } = Astro.props;
---

<a class:list={['row', { compact }]} href={`/blog/${post.id}/`}>
	<div class="meta">
		<time class="label" datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
		{!compact && <div class="minutes">{readingMinutes(post)} min read</div>}
	</div>
	<div class="body">
		<h3>{post.data.title}</h3>
		<p>{post.data.summary}</p>
	</div>
</a>

<style>
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 40px;
		padding: 32px 0;
		border-top: 1px solid var(--border);
		color: var(--ink);
		text-decoration: none;
	}
	.row:last-child {
		border-bottom: 1px solid var(--border);
	}
	.row.compact {
		padding: 24px 0;
	}
	.row:hover h3 {
		color: var(--accent-text);
	}

	.meta {
		flex: 0 0 260px;
		padding-top: 6px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		color: var(--ink-muted);
	}
	.minutes {
		font-size: 13px;
	}

	.body {
		flex: 999 1 480px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	h3 {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 24px;
		line-height: 30px;
	}
	.compact h3 {
		font-size: 22px;
		line-height: 28px;
	}

	p {
		margin: 0;
		color: var(--ink-muted);
		font-size: 16px;
		line-height: 26px;
	}
</style>
