---
import DownloadButton from './DownloadButton.astro';
import { getPosts } from '../utils/blog';

export type Page = 'home' | 'about' | 'work' | 'projects' | 'blog';

export interface Props {
	/** Which menu item to highlight. */
	current?: Page;
}

const { current } = Astro.props;

// The Blog link only appears once there is at least one published post.
const hasPosts = (await getPosts()).length > 0;

const links: { id: Page; label: string; href: string }[] = [
	{ id: 'home', label: 'Home', href: '/' },
	{ id: 'about', label: 'About Me', href: '/about/' },
	{ id: 'work', label: 'My Work', href: '/work/' },
	{ id: 'projects', label: 'My Projects', href: '/projects/' },
	...(hasPosts ? [{ id: 'blog' as const, label: 'Blog', href: '/blog/' }] : []),
];
---

<div class="nav-bar">
	<nav class="container" aria-label="Main">
		{
			links.map((link) => (
				<a href={link.href} aria-current={link.id === current ? 'page' : undefined}>
					{link.label}
				</a>
			))
		}
		<DownloadButton label="Résumé PDF" size="small" />
	</nav>
</div>

<style>
	.nav-bar {
		position: relative;
		background: var(--nav-bg);
		border-bottom: 1px solid var(--border);
		box-shadow: 0 5px 8px rgba(0, 0, 0, 0.2);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-start;
		gap: 4px 32px;
		padding-block: 6px;
		font-family: var(--font-ui);
		font-weight: 500;
		font-size: 14px;
		line-height: 20px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	nav > a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--ink);
		text-decoration: underline;
	}

	nav > a:hover,
	nav > a[aria-current='page'] {
		color: var(--accent-text);
	}
</style>
