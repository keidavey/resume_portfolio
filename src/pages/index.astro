---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DownloadButton from '../components/DownloadButton.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Skills from '../components/Skills.astro';
import { profile } from '../data/profile';
import { sortProjects } from '../utils/projects';

const projects = sortProjects(await getCollection('projects'));
---

<Layout title={`${profile.name} — ${profile.role}`} current="home">
	<section id="about" class="container hero">
		<div class="intro">
			<div class="label eyebrow">{profile.role} · {profile.location}</div>
			<h1>{profile.name}</h1>
			<p class="summary">{profile.summary}</p>
			<div class="actions">
				<DownloadButton id="resume-pdf" />
				<a class="btn btn-ghost" href="#work">See my work</a>
			</div>
		</div>
		{
			profile.portrait ? (
				<img class="portrait" src={profile.portrait} alt={`Portrait of ${profile.name}`} />
			) : (
				<div class="portrait placeholder">[Portrait photo]</div>
			)
		}
	</section>

	<section id="experience" class="band">
		<div class="container stack">
			<div class="section-head">
				<h2>Experience</h2>
				<a class="label" href={profile.resumePdf} download>Full history in the PDF →</a>
			</div>
			<div>
				{profile.experience.map((job) => <ExperienceItem job={job} />)}
			</div>
		</div>
	</section>

	<section id="work" class="band work">
		<div class="container stack">
			<div class="heading">
				<div class="label eyebrow">Selected work</div>
				<h2>Things I've made</h2>
			</div>
			<div class="grid">
				{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
			</div>
		</div>
	</section>

	<Skills />
</Layout>

<style>
	.hero {
		padding-block: 96px 80px;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
		align-items: center;
	}

	.intro {
		flex: 999 1 560px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.eyebrow {
		color: var(--accent-text);
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(40px, 6vw, 64px);
		line-height: 1.12;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.summary {
		margin: 0;
		font: var(--text-body-lg);
		color: var(--ink-muted);
		max-width: 60ch;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 8px;
	}

	.portrait {
		flex: 1 1 280px;
		max-width: 360px;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius-lg);
		padding: 20px;
	}
	img.portrait {
		padding: 0;
	}

	.band {
		border-top: 1px solid var(--border);
	}

	.work {
		background: var(--accent-subtle);
		border-top: 0;
	}

	.stack {
		padding-block: 80px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}

	.heading {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	h2 {
		margin: 0;
		font: var(--text-heading-2);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 24px;
	}
</style>
