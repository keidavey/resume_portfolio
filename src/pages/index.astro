---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DownloadButton from '../components/DownloadButton.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Portrait from '../components/Portrait.astro';
import PostRow from '../components/PostRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { jobs } from '../data/job';
import { profile } from '../data/profile';
import { getPosts } from '../utils/blog';
import { sortProjects } from '../utils/projects';

const currentJob = jobs[0];
const featured = sortProjects(await getCollection('projects')).slice(0, 3);
const latestPosts = (await getPosts()).slice(0, 2);
---

<Layout title={`${profile.name} — ${profile.role}`} current="home">
	<section class="container hero">
		<div class="intro">
			<div class="eyebrow">{profile.role} · {profile.location}</div>
			<h1>{profile.name}</h1>
			<p class="lead">{profile.summary}</p>
			<div class="actions">
				<DownloadButton />
				<a class="btn btn-ghost" href="/projects/">See my projects</a>
			</div>
		</div>
		<Portrait />
	</section>

	{
		currentJob && (
			<section class="divided">
				<div class="container stack">
					<SectionHeader
						eyebrow="Currently"
						title="Experience"
						link={{ href: '/work/', label: 'All experience' }}
					/>
					<div>
						<ExperienceItem job={currentJob} compact />
					</div>
				</div>
			</section>
		)
	}

	{
		featured.length > 0 && (
			<section class="band-alt">
				<div class="container stack">
					<SectionHeader
						eyebrow="Featured projects"
						title="Things I've made"
						link={{ href: '/projects/', label: 'All projects' }}
					/>
					<div class="grid">
						{featured.map((project, index) => (
							<ProjectCard project={project} index={index} />
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		latestPosts.length > 0 && (
			<section>
				<div class="container stack">
					<SectionHeader
						eyebrow="From the blog"
						title="Latest writing"
						link={{ href: '/blog/', label: 'All posts' }}
					/>
					<div>
						{latestPosts.map((post) => (
							<PostRow post={post} compact />
						))}
					</div>
				</div>
			</section>
		)
	}
</Layout>

<style>
	.hero {
		padding-block: 96px 80px;
		display: flex;
		flex-wrap: wrap;
		gap: 56px;
		align-items: center;
	}

	.intro {
		flex: 999 1 560px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	h1 {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(40px, 6vw, 64px);
		line-height: 1.12;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 8px;
	}

	.divided {
		border-top: 1px solid var(--border);
	}

	.stack {
		padding-block: 80px;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 24px;
	}
</style>
