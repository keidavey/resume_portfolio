---
import '../styles/global.css';
import Header from '../components/Header.astro';
import NavBar, { type Page } from '../components/NavBar.astro';
import { profile } from '../data/profile';

export interface Props {
	title: string;
	description?: string;
	/** Which menu item to highlight. */
	current?: Page;
}

const { title, description = profile.summary, current } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="light" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<NavBar current={current} />
		<main id="top">
			<slot />
		</main>
	</body>
</html>
